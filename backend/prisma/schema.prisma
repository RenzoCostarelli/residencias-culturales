generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  SUPERADMIN
  ADMIN_GRUPO
  EVALUADOR
}

enum EstadoEvaluacionInscripto {
  PENDIENTE
  EN_PROGRESO
  EVALUADO
}

enum ResultadoFinalInscripto {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  LISTA_ESPERA
}

enum TipoDatoCampo {
  TEXTO
  TEXTO_LARGO
  NUMERO
  FECHA
  OPCION_UNICA
  OPCION_MULTIPLE
  BOOLEANO
  URL
}

enum EstadoImportacion {
  PENDIENTE
  PROCESANDO
  COMPLETADO
  ERROR
}

enum EstadoPreseleccion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoDocumentoPreseleccion {
  CORRECTO
  FALTANTE
  INCORRECTO
}

enum RolEspecialCampo {
  NOMBRE_COMPLETO
  EMAIL
  DNI
  TELEFONO
  FECHA_NACIMIENTO
  ZONA_GRUPO
}

model Usuario {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  nombre       String
  apellido     String
  rol          RolUsuario
  activo       Boolean    @default(true)
  // true cuando la contraseña vigente fue generada por el sistema (alta o restablecimiento):
  // el frontend muestra el aviso para cambiarla hasta que el usuario lo haga.
  debeCambiarPassword Boolean @default(false) @map("debe_cambiar_password")
  createdById  String?    @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  gruposAdministrados  GrupoAdministrador[]
  gruposComoEvaluador  GrupoEvaluador[]
  paresComoEvaluador1  ParEvaluadores[]      @relation("Evaluador1")
  paresComoEvaluador2  ParEvaluadores[]      @relation("Evaluador2")
  evaluaciones         Evaluacion[]
  preseleccionesHechas Inscripto[]           @relation("PreseleccionPor")

  @@map("usuarios")
}

model Grupo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  administradores GrupoAdministrador[]
  evaluadores     GrupoEvaluador[]
  pares           ParEvaluadores[]
  lotes           Lote[]
  inscriptos      Inscripto[]

  @@map("grupos")
}

model GrupoAdministrador {
  grupoId   String   @map("grupo_id")
  usuarioId String   @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([grupoId, usuarioId])
  @@map("grupo_administradores")
}

// Usuarios (de cualquier rol) habilitados para evaluar en un grupo. Los pares de un grupo
// solo pueden armarse entre sus evaluadores, y la página del evaluador muestra una pestaña
// por cada grupo donde integra un par activo.
model GrupoEvaluador {
  grupoId   String   @map("grupo_id")
  usuarioId String   @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([grupoId, usuarioId])
  @@map("grupo_evaluadores")
}

model ParEvaluadores {
  id           String   @id @default(uuid())
  grupoId      String   @map("grupo_id")
  evaluador1Id String   @map("evaluador_1_id")
  evaluador2Id String   @map("evaluador_2_id")
  activo       Boolean  @default(true)
  createdById  String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  grupo      Grupo       @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  evaluador1 Usuario     @relation("Evaluador1", fields: [evaluador1Id], references: [id])
  evaluador2 Usuario     @relation("Evaluador2", fields: [evaluador2Id], references: [id])
  lotes      Lote[]
  inscriptos Inscripto[]

  @@unique([grupoId, evaluador1Id, evaluador2Id])
  @@map("pares_evaluadores")
}

model Lote {
  id          String   @id @default(uuid())
  grupoId     String   @map("grupo_id")
  nombre      String
  parId       String?  @map("par_id")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  grupo      Grupo           @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  par        ParEvaluadores? @relation(fields: [parId], references: [id])
  inscriptos Inscripto[]

  @@map("lotes")
}

model CampoFormulario {
  id             String        @id @default(uuid())
  clave          String        @unique
  etiqueta       String
  tipoDato       TipoDatoCampo @map("tipo_dato")
  esIdentificatorio Boolean    @default(false) @map("es_identificatorio")
  esEvaluable    Boolean       @default(false) @map("es_evaluable")
  puntajeMaximo  Decimal?      @map("puntaje_maximo") @db.Decimal(5, 2)
  rolEspecial    RolEspecialCampo? @map("rol_especial")
  // Agrupación de campos identificatorios bajo un criterio evaluable: ej. "Experiencia 1 - Lugar"
  // cuelga de "2.2 Experiencia laboral" con agrupador "Experiencia 1" y etiquetaCorta "Lugar".
  // En el formulario de evaluación cada criterio muestra sus subcampos agrupados como párrafos.
  padreId        String?       @map("padre_id")
  agrupador      String?
  etiquetaCorta  String?       @map("etiqueta_corta")
  orden          Int           @default(0)
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  padre     CampoFormulario?  @relation("Subcampos", fields: [padreId], references: [id], onDelete: SetNull)
  subcampos CampoFormulario[] @relation("Subcampos")

  respuestas             RespuestaInscripto[]
  detalles               EvaluacionDetalle[]
  preseleccionDocumentos PreseleccionDocumento[]

  @@unique([rolEspecial])
  @@map("campos_formulario")
}

model ImportacionExcel {
  id                String            @id @default(uuid())
  archivoNombre     String            @map("archivo_nombre")
  archivoHash       String            @map("archivo_hash")
  rutaArchivo       String?           @map("ruta_archivo")
  hojaSeleccionada  String?           @map("hoja_seleccionada")
  filasTotales    Int               @default(0) @map("filas_totales")
  filasImportadas Int               @default(0) @map("filas_importadas")
  filasError      Int               @default(0) @map("filas_error")
  mapeoColumnas   Json?             @map("mapeo_columnas")
  estado          EstadoImportacion @default(PENDIENTE)
  importadoPorId  String?           @map("importado_por")
  logErrores      Json?             @map("log_errores")
  createdAt       DateTime          @default(now()) @map("created_at")
  finishedAt      DateTime?         @map("finished_at")

  inscriptos Inscripto[]

  @@map("importaciones_excel")
}

model Inscripto {
  id        String @id @default(uuid())
  uid       String @unique

  nombreCompleto  String  @map("nombre_completo")
  email           String?
  dni             String? @unique
  telefono        String?
  fechaNacimiento DateTime? @map("fecha_nacimiento")

  grupoId String? @map("grupo_id")
  loteId  String? @map("lote_id")
  parId   String? @map("par_id")

  // Preselección: antes de evaluar, un integrante del par valida la documentación subida
  // (documento por documento, ver PreseleccionDocumento) y aprueba o rechaza al inscripto.
  estadoPreseleccion      EstadoPreseleccion @default(PENDIENTE) @map("estado_preseleccion")
  preseleccionObservacion String?            @map("preseleccion_observacion")
  preseleccionPorId       String?            @map("preseleccion_por")
  preseleccionAt          DateTime?          @map("preseleccion_at")

  estadoEvaluacion EstadoEvaluacionInscripto @default(PENDIENTE) @map("estado_evaluacion")
  resultadoFinal   ResultadoFinalInscripto   @default(PENDIENTE) @map("resultado_final")
  puntajeFinal     Decimal?                  @map("puntaje_final") @db.Decimal(5, 2)

  resultadoDecididoPorId String?   @map("resultado_decidido_por")
  resultadoDecididoAt    DateTime? @map("resultado_decidido_at")

  importacionId String? @map("importacion_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grupo           Grupo?            @relation(fields: [grupoId], references: [id])
  lote            Lote?             @relation(fields: [loteId], references: [id])
  par             ParEvaluadores?   @relation(fields: [parId], references: [id])
  importacion     ImportacionExcel? @relation(fields: [importacionId], references: [id])
  preseleccionPor Usuario?          @relation("PreseleccionPor", fields: [preseleccionPorId], references: [id])

  respuestas             RespuestaInscripto[]
  evaluaciones           Evaluacion[]
  preseleccionDocumentos PreseleccionDocumento[]

  @@map("inscriptos")
}

// Resultado de la validación de cada documento (campos tipo URL) en la preselección.
// Se conserva aunque el inscripto sea rechazado: sirve para saber dónde se equivoca más la gente al inscribirse.
model PreseleccionDocumento {
  id          String                      @id @default(uuid())
  inscriptoId String                      @map("inscripto_id")
  campoId     String                      @map("campo_id")
  estado      EstadoDocumentoPreseleccion
  observacion String?

  inscripto Inscripto       @relation(fields: [inscriptoId], references: [id], onDelete: Cascade)
  campo     CampoFormulario @relation(fields: [campoId], references: [id])

  @@unique([inscriptoId, campoId])
  @@map("preseleccion_documentos")
}

model RespuestaInscripto {
  id          String  @id @default(uuid())
  inscriptoId String  @map("inscripto_id")
  campoId     String  @map("campo_id")
  valorTexto  String? @map("valor_texto")

  inscripto Inscripto       @relation(fields: [inscriptoId], references: [id], onDelete: Cascade)
  campo     CampoFormulario @relation(fields: [campoId], references: [id])

  @@unique([inscriptoId, campoId])
  @@map("respuestas_inscripto")
}

// Una evaluación existe solo cuando fue enviada completa: no hay borradores y no se puede editar.
model Evaluacion {
  id                String   @id @default(uuid())
  inscriptoId       String   @map("inscripto_id")
  evaluadorId       String   @map("evaluador_id")
  puntajeTotal      Decimal  @map("puntaje_total") @db.Decimal(5, 2)
  comentarioGeneral String?  @map("comentario_general")
  fechaCompletada   DateTime @default(now()) @map("fecha_completada")

  inscripto Inscripto @relation(fields: [inscriptoId], references: [id], onDelete: Cascade)
  evaluador Usuario   @relation(fields: [evaluadorId], references: [id])
  detalles  EvaluacionDetalle[]

  @@unique([inscriptoId, evaluadorId])
  @@map("evaluaciones")
}

model EvaluacionDetalle {
  id           String   @id @default(uuid())
  evaluacionId String   @map("evaluacion_id")
  campoId      String   @map("campo_id")
  puntaje      Decimal  @db.Decimal(5, 2)
  comentario   String?

  evaluacion Evaluacion      @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  campo      CampoFormulario @relation(fields: [campoId], references: [id])

  @@unique([evaluacionId, campoId])
  @@map("evaluacion_detalles")
}
